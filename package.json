{
  "name": "@double-coding/dsh-skill-center",
  "version": "0.2.1",
  "description": "Local skill manager for DeepSeek Harness: list, toggle, create, import and install skills from ClawHub.",
  "icon": "assets/plugin-icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "clawhub"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/double-coding-lab/dsh-skill-center.git"
  },
  "homepage": "https://github.com/double-coding-lab/dsh-skill-center#readme",
  "bugs": {
    "url": "https://github.com/double-coding-lab/dsh-skill-center/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "assets/plugin-icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "test": "node scripts/test-core.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "link:web": "npm run build && dsh plugin --profile web add link:."
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.1 <0.3.0-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "zod": "4.4.3"
  },
  "overrides": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
